{
	"path": ["src", "tests", "eslint.config.js", "vite.config.ts"],
	"format": ["typescript", "javascript", "svelte"],
	"ignore": ["**/*.test.ts", "**/schema.d.ts"],
	"minLines": 10,
	"minTokens": 60,
	"threshold": 0,
	"reporters": ["console"],
	"exitCode": 1,
	"gitignore": true,
	"failOnEmpty": true
}
