{
	"name": "open-customer-web",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": "26.13.0"
	},
	"packageManager": "pnpm@12.16.1",
	"scripts": {
		"build": "vite build",
		"dev": "vite dev",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "eslint . && prettier --check . && knip && jscpd",
		"gen:api": "openapi-typescript ../api/openapi.yaml -o src/lib/api/schema.d.ts",
		"format": "prettier --write .",
		"test": "vitest run --passWithNoTests"
	},
	"dependencies": {
		"dexie": "4.4.7",
		"openapi-fetch": "0.17.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.4",
		"@types/node": "26.6.6",
		"@types/pg": "8.23.1",
		"@vitest/eslint-plugin": "1.6.28",
		"eslint": "10.14.0",
		"eslint-plugin-playwright": "2.12.2",
		"eslint-plugin-svelte": "3.24.0",
		"fake-indexeddb": "6.2.7",
		"globals": "17.14.0",
		"jscpd": "^5.4.2",
		"knip": "^6.44.1",
		"openapi-typescript": "7.13.0",
		"pg": "8.23.1",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"tailwindcss": "4.3.4",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1",
		"vite": "8.3.5",
		"vitest": "5.1.0"
	}
}
